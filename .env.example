# ─────────────────────────────────────────────────────────────────────────────
# KrishiSat — environment template (PRD §21.1, §15.7)
#
# Copy to .env and fill in locally. `.env` is git-ignored; this file is committed
# and MUST NOT ever contain a real value.
#
# NEVER prefix the Supabase variables or CRON_SECRET with VITE_. Anything named
# VITE_* is inlined into the browser bundle at build time, which would publish the
# service-role key to every visitor (PRD §21.1).
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (public by definition — inlined at build time) ──
# Same-origin in production; point at the local API during development.
VITE_API_URL=http://localhost:5000

# ── API runtime (local development) ──
PORT=5000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ── API runtime ONLY — server-side secrets (PRD §15.7, §14.5) ──
# The service-role key bypasses row-level security. It is read only by
# backend/repositories/recommendations.js and must never reach a client,
# an API response, or a log line.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Scheduled job authentication (PRD §21.2) ──
# Vercel sends `Authorization: Bearer $CRON_SECRET` to the cron endpoint. With this
# unset the endpoint fails closed and refuses to run.
CRON_SECRET=
